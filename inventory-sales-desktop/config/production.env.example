# Copy this file to the application config folder as production.env and set real local values.
# Windows path: %APPDATA%\Inventory Sales Management\production.env
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/inventory_sales?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
FRONTEND_URL="http://127.0.0.1:5174"
PAYMENT_METHODS="CASH,CARD,MPESA,AIRTEL_MONEY,BANK_TRANSFER,CHEQUE,CREDIT,OTHER"

# Optional Safaricom Daraja M-Pesa STK Push configuration.
MPESA_ENV="production"
MPESA_CONSUMER_KEY="your-daraja-consumer-key"
MPESA_CONSUMER_SECRET="your-daraja-consumer-secret"
MPESA_SHORTCODE="your-production-business-shortcode"
MPESA_PASSKEY="your-daraja-passkey"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_PARTY_B="your-production-business-number"
# This must be a public HTTPS URL that forwards to the packaged API callback.
MPESA_CALLBACK_URL="https://your-public-host.example.com/api/sales/mpesa/callback"
