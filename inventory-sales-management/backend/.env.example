DATABASE_URL=postgresql://postgres:password@localhost:5432/inventory_sales
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
FRONTEND_URL=http://localhost:5174
PAYMENT_METHODS=CASH,CARD,MPESA,AIRTEL_MONEY,BANK_TRANSFER,CHEQUE,CREDIT,OTHER

# Safaricom Daraja M-Pesa STK Push
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-daraja-passkey
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=174379
# Must be a public HTTPS URL in Daraja, for example via a tunnel during development.
MPESA_CALLBACK_URL=https://your-public-host.example.com/api/sales/mpesa/callback